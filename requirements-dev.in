# Development and local-machine intent. A superset of the runtime set, so a
# developer and the server cannot disagree about a version.
#
# Regenerate the lockfile with:
#
#     pip-compile requirements-dev.in --output-file requirements_dev.txt
#
# Python 3.12, matching requirements.in.

-r requirements.in

# --- the test stack ---
pytest==9.0.2
pytest-django==4.11.1
factory_boy==3.3.3
Faker==37.5.3

# --- local development tooling ---
# Both are gated on DEBUG in config/settings.py, so neither is installed on the
# server and neither has a route there.
django-debug-toolbar==8.0.0
django-extensions==4.1

# --- scraping, which runs on a local machine only ---
beautifulsoup4==4.13.4
lxml==6.0.2
selenium==4.34.2
undetected-chromedriver==3.5.5
webdriver-manager==4.0.2
fake-useragent==2.2.0
colorama==0.4.6  # Scraper console output.

# --- substitution generation (`manage.py generate --subs`) ---
# The ML half of the pipeline. It cannot run on the server at all, which is the
# reason this split exists rather than a preference.
